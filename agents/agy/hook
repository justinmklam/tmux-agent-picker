#!/usr/bin/env bash
set -u

# agy hook shim: gate events by conversationId, then delegate to the shared
# wrapper. agy requires every hook to print JSON on stdout. PreToolUse (permission)
# requires an explicit decision to allow tool execution, while other hooks expect {}.
# This script always exits 0, even when it rejects the event.
#
# agy loads this through a symlinked plugin directory, so it must not derive the
# checkout path from BASH_SOURCE. The dispatcher is on PATH instead.
verb=${1:-}
pane=${TMUX_PANE:-}

print_response() {
  if [[ $verb == permission ]]; then
    printf '{"decision":"allow"}\n'
  else
    printf '{}\n'
  fi
}

if [[ -z $pane ]]; then
  print_response
  exit 0
fi

payload=''
if [[ ! -t 0 ]]; then
  payload=$(cat 2>/dev/null || true)
fi
conversation=$(printf '%s' "$payload" |
  sed -n 's/.*"conversationId"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' |
  head -n 1)

runtime=${XDG_RUNTIME_DIR:-${TMPDIR:-/tmp}}/tmux-agent-picker
if ! mkdir -p "$runtime" 2>/dev/null; then
  runtime="${HOME:-}/.cache/tmux-agent-picker"
  mkdir -p "$runtime" 2>/dev/null || runtime=''
fi
if [[ -n $runtime ]]; then
  chmod 700 "$runtime" 2>/dev/null || true
fi

conv_file=''
[[ -n $runtime ]] && conv_file="$runtime/agy-$(id -u)-${pane#%}.conv"

allowed=1
if [[ $verb == session ]]; then
  [[ -n $conv_file ]] && printf '%s' "$conversation" >"$conv_file" 2>/dev/null
else
  stored=''
  [[ -n $conv_file && -r $conv_file ]] && stored=$(cat "$conv_file" 2>/dev/null || true)
  if [[ -n $conversation ]]; then
    if [[ -n $stored && $stored != "$conversation" ]]; then
      allowed=0
    elif [[ -z $stored && -n $conv_file ]]; then
      printf '%s' "$conversation" >"$conv_file" 2>/dev/null || true
    fi
  fi
fi

if [[ $allowed == 1 ]]; then
  printf '%s' "$payload" | tmux-agent-picker hook agy "$verb" >/dev/null 2>&1 || true
fi

print_response
exit 0
