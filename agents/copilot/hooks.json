{
  "version": 1,
  "hooks": {
    "sessionStart": [
      { "type": "command", "bash": "tmux-agent-picker hook copilot session", "timeoutSec": 5 }
    ],
    "userPromptSubmitted": [
      { "type": "command", "bash": "tmux-agent-picker hook copilot prompt", "timeoutSec": 5 }
    ],
    "permissionRequest": [
      { "type": "command", "bash": "tmux-agent-picker hook copilot permission", "timeoutSec": 5 }
    ],
    "postToolUse": [
      { "type": "command", "bash": "tmux-agent-picker hook copilot activity", "timeoutSec": 5 }
    ],
    "postToolUseFailure": [
      { "type": "command", "bash": "tmux-agent-picker hook copilot activity", "timeoutSec": 5 }
    ],
    "agentStop": [
      { "type": "command", "bash": "tmux-agent-picker hook copilot stop", "timeoutSec": 5 }
    ],
    "errorOccurred": [
      { "type": "command", "bash": "tmux-agent-picker hook copilot stop", "timeoutSec": 5 }
    ],
    "sessionEnd": [
      { "type": "command", "bash": "tmux-agent-picker hook copilot end", "timeoutSec": 3 }
    ]
  }
}
