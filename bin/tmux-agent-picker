#!/usr/bin/env bash
set -u

# Single entry point for humans and agent hooks. Hook configs call
# `tmux-agent-picker hook <agent> <verb>` so they never carry a checkout path;
# the bin/agent-* scripts stay private implementation details.

# Resolve the symlink chain so a link in ~/.local/bin still finds the checkout.
resolve_self() {
  local path=${BASH_SOURCE[0]} target dir hops=0
  while [[ -L $path ]]; do
    hops=$((hops + 1))
    (( hops <= 40 )) || break
    target=$(readlink "$path" 2>/dev/null) || break
    case $target in
      /*) path=$target ;;
      *) path=$(dirname "$path")/$target ;;
    esac
  done
  dir=$(cd "$(dirname "$path")" 2>/dev/null && pwd -P) || dir=$(dirname "$path")
  printf '%s/%s\n' "${dir%/}" "$(basename "$path")"
}

root=$(cd "$(dirname "$(resolve_self)")/.." && pwd -P)

usage() {
  cat <<'EOF'
Usage: tmux-agent-picker <command> [args...]

Commands:
  hook <agent> <verb>   Report lifecycle state from a hook payload
  install [agent...]    Install or refresh agent lifecycle integrations
  status [agent...]     Report agent integration state
  uninstall [agent...]  Remove integrations this checkout installed
  link                  Link the dispatcher onto PATH without touching agent config
  pick                  Open the agent picker
  new                   Open the directory picker and switch or create a session
  state <command>       Call the low-level pane state writer

Arguments after the command are passed through unchanged.
EOF
}

[[ $# -gt 0 ]] || {
  usage >&2
  exit 1
}
command_name=$1
shift

case $command_name in
  hook) exec "$root/bin/agent-hook" "$@" ;;
  install) exec "$root/bin/agent-install" "$@" ;;
  status) exec "$root/bin/agent-install" --status "$@" ;;
  uninstall) exec "$root/bin/agent-install" --uninstall "$@" ;;
  link) exec "$root/bin/agent-install" --link "$@" ;;
  pick) exec "$root/bin/agent-pick" "$@" ;;
  new) exec "$root/bin/agent-new" "$@" ;;
  state) exec "$root/bin/agent-state" "$@" ;;
  help | -h | --help)
    usage
    exit 0
    ;;
  *)
    usage >&2
    exit 1
    ;;
esac
