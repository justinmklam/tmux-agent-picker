#!/usr/bin/env bash
set -u

TMUX_BIN=${TMUX_BIN:-tmux}
ROOT=$(cd "$(dirname "$0")/.." && pwd)
NORMAL_FOOTER='Tab session order  Enter  n  x kill  /  j/k  q/Esc'
SESSION_FOOTER='Tab state order  Enter  n  x kill  /  j/k  q/Esc'
FILTER_FOOTER='Tab session order  type to filter  Enter  Esc back'
FILTER_SESSION_FOOTER='Tab state order  type to filter  Enter  Esc back'
EMPTY_FOOTER='Tab session order  no agents  Enter  n  /  j/k  q/Esc'
EMPTY_SESSION_FOOTER='Tab state order  no agents  Enter  n  /  j/k  q/Esc'
DEFAULT_BORDER_LABEL=' agents · Tab sess '
SESSION_BORDER_LABEL=' agents · Tab state '

theme_option() {
  "$TMUX_BIN" show-options -gv "$1" 2>/dev/null || true
}

DEFAULT_AGENT_NAMES='claude codex copilot agy gemini aider opencode goose crush cursor-agent'

# Detection state, filled once per listing so no per-pane process is spawned.
AGENT_NAMES=''
AGENT_MATCH=''
DETECTED_AGENT=''
PROC_TABLE_LOADED=0
PROC_PIDS=''
PROC_PARENT=()
PROC_COMMAND=()
PROC_PARENTS=''
SESSION_COLOURS=()
NOW=0

age_for() {
  local since=$1 age
  case $since in
    '' | *[!0-9]*) since=$NOW ;;
  esac
  age=$((NOW - since))
  (( age < 0 )) && age=0
  if (( age < 60 )); then
    printf '%ss' "$age"
  elif (( age < 3600 )); then
    printf '%sm' $((age / 60))
  elif (( age < 86400 )); then
    printf '%sh' $((age / 3600))
  else
    printf '%sd' $((age / 86400))
  fi
}

# The configured name list. `off` disables detection and process inspection;
# `on` and an unset option select the built-in list. A leading `+` extends the
# built-in list with the names that follow it, so `+mytool` keeps the defaults.
agent_names() {
  local names
  names=$(theme_option @ap_detect_agents)
  case $names in
    [Oo][Ff][Ff]) return 0 ;;
    '' | [Oo][Nn]) printf '%s' "$DEFAULT_AGENT_NAMES" ;;
    +*) printf '%s %s' "$DEFAULT_AGENT_NAMES" "${names//+/}" ;;
    *) printf '%s' "$names" ;;
  esac
}

# Sets AGENT_MATCH to the first token that names a configured agent. Tokens are
# split on whitespace and "/"; a trailing interpreter extension is ignored.
match_agent_token() {
  local text=${1:-} token base
  local -a tokens
  AGENT_MATCH=''
  [[ -n $text && -n $AGENT_NAMES ]] || return 1
  IFS=$' \t\n/' read -ra tokens <<< "$text"
  for token in "${tokens[@]}"; do
    base=${token%.js}
    base=${base%.mjs}
    base=${base%.cjs}
    base=${base%.py}
    base=${base%.exe}
    case $base in
      '' | *[!a-z0-9_-]*) continue ;;
    esac
    (( ${#base} > 16 )) && continue
    case " $AGENT_NAMES " in
      *" $base "*)
        AGENT_MATCH=$base
        return 0
        ;;
    esac
  done
  return 1
}

# Take one process snapshot per listing. Detection then costs no process spawns,
# which matters because a listing walks every pane. Indexed arrays keyed by pid
# keep this compatible with the bash 3.2 that macOS ships.
load_process_table() {
  local pid ppid rest
  (( PROC_TABLE_LOADED )) && return 0
  PROC_TABLE_LOADED=1
  while read -r pid ppid rest; do
    case $pid$ppid in
      '' | *[!0-9]*) continue ;;
    esac
    PROC_PIDS+=" $pid"
    PROC_PARENT[$pid]=$ppid
    PROC_COMMAND[$pid]=$rest
    PROC_PARENTS+=" $ppid"
  done < <(ps -A -o pid=,ppid=,command= 2>/dev/null || true)
  [[ -n $PROC_PIDS ]]
}

# Look for an agent name in this process and, up to two levels below the pane,
# in its children. Sets AGENT_MATCH. Shell wrappers and shims hide the agent
# name this way.
process_has_agent() {
  local pid=$1 depth=$2 child
  match_agent_token "${PROC_COMMAND[$pid]:-}" && return 0
  (( depth >= 2 )) && return 1
  # Skipping childless processes keeps most panes off the full scan below.
  case " $PROC_PARENTS " in
    *" $pid "*) ;;
    *) return 1 ;;
  esac
  for child in $PROC_PIDS; do
    [[ ${PROC_PARENT[$child]:-} == "$pid" ]] || continue
    process_has_agent "$child" $((depth + 1)) && return 0
  done
  return 1
}

# Best-effort detection for a pane with no reported state. Sets DETECTED_AGENT
# and never fails the listing: a missing ps or an unreadable process simply
# reports no match.
detect_agent_for_pane() {
  local pid=${1:-} command=${2:-}
  DETECTED_AGENT=''
  [[ -n $AGENT_NAMES ]] || return 1
  if match_agent_token "${command:-}"; then
    DETECTED_AGENT=$AGENT_MATCH
    return 0
  fi
  [[ -n $pid ]] || return 1
  case $pid in
    *[!0-9]*) return 1 ;;
  esac
  load_process_table || return 1
  process_has_agent "$pid" 0 || return 1
  DETECTED_AGENT=$AGENT_MATCH
}

active_pane_for_session() {
  local session=$1 pane
  pane=$($TMUX_BIN display-message -p -t "$session" '#{pane_id}' 2>/dev/null || true)
  printf '%s' "$pane"
}

list_agents() {
  local current_pane=${1:-${TMUX_PANE:-}} metadata=${2:-0} sort_order=${3:-state}
  local pane state since agent session session_id window pane_index command title pid
  local tier age display current_rank
  local session_pane sessions_with_agents=''
  local -a sort_args
  local format=$'#{pane_id}\x1f#{@ap_state}\x1f#{@ap_since}\x1f#{@ap_agent}\x1f#{session_name}\x1f#{window_index}\x1f#{pane_index}\x1f#{pane_current_command}\x1f#{pane_title}\x1f#{session_id}\x1f#{pane_pid}'
  case "$sort_order" in
    session) sort_args=(-k1,1n -k6,6 -k3,3nr -k4,4 -k5,5) ;;
    *) sort_order=state; sort_args=(-k1,1n -k2,2n -k3,3nr -k4,4 -k5,5) ;;
  esac
  {
    AGENT_NAMES=$(agent_names)
    NOW=$(date +%s)
    while IFS=$'\x1f' read -r pane state since agent session window pane_index command title session_id pid; do
      [[ -n $pane ]] || continue
      current_rank=1
      [[ -n $current_pane && $pane == "$current_pane" ]] && current_rank=0
      # A pane without state may still be an agent: detected agents cannot
      # report working, blocked, or done, so they enter the idle tier.
      if [[ -z $state ]]; then
        detect_agent_for_pane "$pid" "$command"
        if [[ -n $DETECTED_AGENT ]]; then
          display="idle"$'\t'"$DETECTED_AGENT"$'\t'"$session:$window.$pane_index"$'\t'"-"$'\t'"$title"
          printf '%s\t3\t0\t%s\t%s\t%s\t%s\n' "$current_rank" "$pane" "$pane" "$session" "$display"
          sessions_with_agents+=" $session_id"
          continue
        fi
      fi
      case "$command" in
        zsh|bash|fish|sh) continue ;;
      esac
      case "$state" in
        blocked) tier=0 ;;
        working) tier=1 ;;
        done) tier=2 ;;
        idle) tier=3 ;;
        *) continue ;;
      esac
      age=$(age_for "$since")
      display="$state"$'\t'"$agent"$'\t'"$session:$window.$pane_index"$'\t'"$age"$'\t'"$title"
      printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$current_rank" "$tier" "${since:-0}" "$pane" "$pane" "$session" "$display"
      sessions_with_agents+=" $session_id"
    done < <($TMUX_BIN list-panes -a -F "$format" 2>/dev/null || true)

    while IFS=$'\x1f' read -r session_id session_name; do
      [[ -n $session_id && -n $session_name ]] || continue
      case " $sessions_with_agents " in
        *" $session_id "*) continue ;;
      esac
      session_pane=$(active_pane_for_session "$session_id")
      [[ -n $session_pane ]] || continue
      current_rank=1
      printf '%s\t4\t0\t%s\t%s\t%s\tsession %s\n' "$current_rank" "$session_pane" "$session_pane" "$session_name" "$session_name"
    done < <($TMUX_BIN list-sessions -F $'#{session_id}\x1f#{session_name}' 2>/dev/null || true)
  } |
    LC_ALL=C sort -t $'\t' "${sort_args[@]}" |
    awk -v metadata="$metadata" -F '\t' '
      {
        pane[NR] = $5
        session_name[NR] = $6
        if (NF >= 10) {
          agent_row[NR] = 1
          state[NR] = $7
          agent[NR] = $8
          location[NR] = $9
          age[NR] = $10
          title[NR] = $11
          for (i = 12; i <= NF; i++) title[NR] = title[NR] OFS $i
          if (length(agent[NR]) > max_agent) max_agent = length(agent[NR])
          if (length(location[NR]) > max_location) max_location = length(location[NR])
        } else {
          display[NR] = $7
        }
      }
      END {
        for (i = 1; i <= NR; i++) {
          if (agent_row[i]) {
            if (metadata) {
              marked_location = sprintf("%c%s%c%s", 30, session_name[i], 31, substr(location[i], length(session_name[i]) + 1))
              printf "%s\t%s\t%-3s  %-*s  %-*s  %-4s  %s\n", pane[i], session_name[i], state[i], max_agent, agent[i], max_location + 2, marked_location, age[i], title[i]
            } else {
              printf "%s\t%-3s  %-*s  %-*s  %-4s  %s\n", pane[i], state[i], max_agent, agent[i], max_location, location[i], age[i], title[i]
            }
          } else if (metadata) {
            printf "%s\t%s\tsession %c%s%c\n", pane[i], session_name[i], 30, session_name[i], 31
          } else {
            printf "%s\t%s\n", pane[i], display[i]
          }
        }
      }'
}

has_agent_rows() {
  local pane session display state
  while IFS=$'\t' read -r pane session display; do
    state=${display%%[[:space:]]*}
    case "$state" in
      blocked|done|idle|working) return 0 ;;
    esac
  done <<< "${1:-}"
  return 1
}

load_session_colours() {
  local configured token red green blue colour
  local -a tokens
  SESSION_COLOURS=()
  configured=$(theme_option @ap_session_colors)
  IFS=$' \t\n' read -ra tokens <<< "$configured"
  (( ${#tokens[@]} > 0 )) || return 0
  for token in "${tokens[@]}"; do
    case "$token" in
      \#[0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f][0-9A-Fa-f])
        red=$((16#${token:1:2}))
        green=$((16#${token:3:2}))
        blue=$((16#${token:5:2}))
        printf -v colour '\033[38;2;%d;%d;%dm' "$red" "$green" "$blue"
        SESSION_COLOURS+=("$colour")
        ;;
    esac
  done
}

colour_agents() {
  local pane session display state colour rest session_colour
  local session_list palette_index
  local marker_start=$'\036' marker_end=$'\037' reset=$'\033[0m'
  local -a row_panes row_sessions row_displays sessions palette_indices
  local row_count=0 session_count=0 palette_count=0 i j

  while IFS=$'\t' read -r pane session display; do
    [[ -n $pane ]] || continue
    row_panes[$row_count]=$pane
    row_sessions[$row_count]=$session
    row_displays[$row_count]=$display
    row_count=$((row_count + 1))
  done

  load_session_colours
  palette_count=${#SESSION_COLOURS[@]}
  if (( row_count > 0 && palette_count > 0 )); then
    session_list=$(printf '%s\n' "${row_sessions[@]}" | LC_ALL=C sort -u)
    while IFS= read -r session; do
      [[ -n $session ]] || continue
      sessions[$session_count]=$session
      session_count=$((session_count + 1))
    done <<< "$session_list"
    for ((i = 0; i < session_count; i++)); do
      if (( session_count <= palette_count )); then
        palette_indices[$i]=$((i * palette_count / session_count))
      else
        palette_indices[$i]=$((i % palette_count))
      fi
    done
  fi

  for ((i = 0; i < row_count; i++)); do
    pane=${row_panes[$i]}
    session=${row_sessions[$i]}
    display=${row_displays[$i]}
    session_colour=''
    if (( session_count > 0 )); then
      for ((j = 0; j < session_count; j++)); do
        [[ ${sessions[$j]} == "$session" ]] || continue
        palette_index=${palette_indices[$j]}
        session_colour=${SESSION_COLOURS[$palette_index]}
        break
      done
    fi
    if [[ -n $session_colour ]]; then
      display=${display//$marker_start/$session_colour}
      display=${display//$marker_end/$reset}
    else
      display=${display//$marker_start/}
      display=${display//$marker_end/}
    fi
    state=${display%%[[:space:]]*}
    rest=${display#*[[:space:]]}
    case "$state" in
      blocked) colour='\033[31m' ;;
      done) colour='\033[32m' ;;
      idle) colour='\033[2m' ;;
      working) colour='\033[33m' ;;
      *) colour='' ;;
    esac
    printf '%s\t%s\t%b%s\033[0m\t%s\n' "$pane" "$session" "$colour" "$state" "$rest"
  done
}

client_quote() {
  printf '%q' "${1:-}"
}

tty_write() {
  { printf "$@"; } > /dev/tty 2>/dev/null || true
}

read_tty_key() {
  local answer=''
  if [[ -t 0 ]]; then
    IFS= read -r -n 1 answer || true
  elif [[ -r /dev/tty ]]; then
    IFS= read -r -n 1 answer < /dev/tty 2>/dev/null || true
  fi
  printf '%s' "$answer"
}

session_id_for_pane() {
  "$TMUX_BIN" display-message -p -t "${1:-}" '#{session_id}' 2>/dev/null || true
}

current_session_id() {
  local target=${TMUX_PANE:-}
  if [[ -n $target ]]; then
    session_id_for_pane "$target"
  else
    "$TMUX_BIN" display-message -p '#{session_id}' 2>/dev/null || true
  fi
}

current_pane_for_client() {
  local client=${1:-}
  if [[ -n $client ]]; then
    "$TMUX_BIN" display-message -p -t "$client" '#{pane_id}' 2>/dev/null || true
  else
    printf '%s' "${TMUX_PANE:-}"
  fi
}

# Kill the session owning the pane under the cursor. Always returns 0: it runs
# from an fzf binding that continues with a reload.
kill_session_for_pane() {
  local pane=${1:-} session_id session_name current answer
  [[ -n $pane ]] || return 0
  session_id=$(session_id_for_pane "$pane")
  [[ -n $session_id ]] || return 0
  session_name=$("$TMUX_BIN" display-message -p -t "$session_id" '#{session_name}' 2>/dev/null || true)
  [[ -n $session_name ]] || session_name=$session_id

  current=$(current_session_id)
  if [[ -n $current && $session_id == "$current" ]]; then
    tty_write 'agent-picker: refusing to kill the current session (%s)\n' "$session_name"
    tty_write 'press any key to return'
    read_tty_key >/dev/null
    return 0
  fi

  tty_write 'kill session %s? [y/N] ' "$session_name"
  answer=$(read_tty_key)
  case "$answer" in
    y | Y) ;;
    *)
      tty_write '\ncancelled\n'
      return 0
      ;;
  esac

  if "$TMUX_BIN" kill-session -t "$session_id" >/dev/null 2>&1; then
    tty_write '\nkilled session %s\n' "$session_name"
  else
    tty_write '\nagent-picker: could not kill session %s\n' "$session_name"
    tty_write 'press any key to return'
    read_tty_key >/dev/null
  fi
  return 0
}

coloured_agents() {
  list_agents "${1:-}" 1 "${2:-state}" | colour_agents
}

go_to_pane() {
  local pane=$1 client=${2:-}
  if [[ -n $client ]]; then
    $TMUX_BIN switch-client -c "$client" -t "$pane" >/dev/null 2>&1 || true
  fi
  $TMUX_BIN select-window -t "$pane" >/dev/null 2>&1 || true
  $TMUX_BIN select-pane -t "$pane" >/dev/null 2>&1 || true
}

toggle_action() {
  local client='' next_order next_prompt footer filter_footer border_label root_q client_q agents
  while [[ $# -gt 0 ]]; do
    case $1 in
      --client)
        if (( $# >= 2 )); then client=$2; shift 2; else client=''; shift; fi
        ;;
      *) shift ;;
    esac
  done
  if [[ ${FZF_PROMPT:-} == session-order* ]]; then
    next_order=state
    next_prompt='attention-order '
    footer=$NORMAL_FOOTER
    filter_footer=$FILTER_FOOTER
    border_label=$DEFAULT_BORDER_LABEL
  else
    next_order=session
    next_prompt='session-order '
    footer=$SESSION_FOOTER
    filter_footer=$FILTER_SESSION_FOOTER
    border_label=$SESSION_BORDER_LABEL
  fi
  agents=$(list_agents "$(current_pane_for_client "$client")" 1 "$next_order")
  if ! has_agent_rows "$agents"; then
    [[ $next_order == session ]] && footer=$EMPTY_SESSION_FOOTER || footer=$EMPTY_FOOTER
  fi
  if [[ ${FZF_INPUT_STATE:-} == enabled ]]; then
    footer=$filter_footer
  fi
  root_q=$(printf '%q' "$ROOT")
  client_q=$(client_quote "$client")
  printf 'reload(%s/bin/agent-pick --rows --client %s --order %s)+change-prompt(%s)+change-footer(%s)+change-border-label(%s)+first' \
    "$root_q" "$client_q" "$next_order" "$next_prompt" "$footer" "$border_label"
}

escape_action() {
  local client='' order=state footer agents
  while [[ $# -gt 0 ]]; do
    case $1 in
      --client)
        if (( $# >= 2 )); then client=$2; shift 2; else client=''; shift; fi
        ;;
      *) shift ;;
    esac
  done
  if [[ ${FZF_INPUT_STATE:-} != enabled ]]; then
    printf 'abort'
    return 0
  fi
  [[ ${FZF_PROMPT:-} == session-order* ]] && order=session
  if [[ $order == session ]]; then
    footer=$SESSION_FOOTER
  else
    footer=$NORMAL_FOOTER
  fi
  agents=$(list_agents "$(current_pane_for_client "$client")" 1 "$order")
  if ! has_agent_rows "$agents"; then
    [[ $order == session ]] && footer=$EMPTY_SESSION_FOOTER || footer=$EMPTY_FOOTER
  fi
  printf 'clear-query+hide-input+rebind(n,x,/,j,k)+change-footer(%s)' "$footer"
}

reload_action() {
  local client='' order=state footer agents root_q client_q
  while [[ $# -gt 0 ]]; do
    case $1 in
      --client)
        if (( $# >= 2 )); then client=$2; shift 2; else client=''; shift; fi
        ;;
      *) shift ;;
    esac
  done
  [[ ${FZF_PROMPT:-} == session-order* ]] && order=session
  if [[ $order == session ]]; then
    footer=$SESSION_FOOTER
  else
    footer=$NORMAL_FOOTER
  fi
  agents=$(list_agents "$(current_pane_for_client "$client")" 1 "$order")
  if ! has_agent_rows "$agents"; then
    [[ $order == session ]] && footer=$EMPTY_SESSION_FOOTER || footer=$EMPTY_FOOTER
  fi
  root_q=$(printf '%q' "$ROOT")
  client_q=$(client_quote "$client")
  printf 'reload(%s/bin/agent-pick --rows --client %s --order %s)+change-footer(%s)' \
    "$root_q" "$client_q" "$order" "$footer"
}

filter_action() {
  local footer=$FILTER_FOOTER
  [[ ${FZF_PROMPT:-} == session-order* ]] && footer=$FILTER_SESSION_FOOTER
  printf 'show-input+unbind(n,x,/,j,k)+change-footer(%s)' "$footer"
}

interactive() {
  local client=${1:-} client_q agents footer theme root_q current_pane border_label fzf_colors=()
  client_q=$(client_quote "$client")
  root_q=$(printf '%q' "$ROOT")
  current_pane=$(current_pane_for_client "$client")
  agents=$(list_agents "$current_pane" 1 state)
  footer=$NORMAL_FOOTER
  border_label=$DEFAULT_BORDER_LABEL
  if ! has_agent_rows "$agents"; then
    footer=$EMPTY_FOOTER
  fi
  theme=$(theme_option @ap_fzf_colors)
  [[ -n $theme ]] && fzf_colors=(--color="$theme")

  exec fzf \
    --ansi --delimiter=$'\t' --nth=1,2,3.. --with-nth=3.. --tiebreak=index --reverse --cycle \
    "${fzf_colors[@]}" \
    --with-shell 'bash -c' --no-input --prompt='attention-order ' --footer "$footer" \
    --border-label="$border_label" --preview 'tmux capture-pane -ep -t {1}' \
    --preview-window='right:50%,follow' \
    --bind "n:become($root_q/bin/agent-new --client $client_q)" \
    --bind "x:execute($root_q/bin/agent-pick --kill {1})+transform($root_q/bin/agent-pick --reload-action --client $client_q)" \
    --bind "tab:transform($root_q/bin/agent-pick --toggle-action --client $client_q)" \
    --bind "/:transform($root_q/bin/agent-pick --filter-action)" \
    --bind 'j:down,k:up' \
    --bind 'change:first' \
    --bind 'q:abort' \
    --bind "esc:transform($root_q/bin/agent-pick --escape-action --client $client_q)" \
    --bind "enter:become($root_q/bin/agent-pick --go {1} --client $client_q)" \
    < <(colour_agents <<< "$agents")
}

parse_picker_args() {
  PICKER_CLIENT=''
  PICKER_ORDER=state
  while [[ $# -gt 0 ]]; do
    case $1 in
      --client)
        if (( $# >= 2 )); then PICKER_CLIENT=$2; shift 2; else PICKER_CLIENT=''; shift; fi
        ;;
      --order)
        if (( $# >= 2 )); then PICKER_ORDER=$2; shift 2; else PICKER_ORDER=state; shift; fi
        ;;
      *) shift ;;
    esac
  done
}

case "${1:-}" in
  --toggle-action)
    shift
    toggle_action "$@"
    ;;
  --escape-action)
    shift
    escape_action "$@"
    ;;
  --reload-action)
    shift
    reload_action "$@"
    ;;
  --filter-action)
    shift
    filter_action
    ;;
  --list)
    shift
    parse_picker_args "$@"
    list_agents "$(current_pane_for_client "$PICKER_CLIENT")" 0 "$PICKER_ORDER"
    ;;
  --rows)
    shift
    parse_picker_args "$@"
    coloured_agents "$(current_pane_for_client "$PICKER_CLIENT")" "$PICKER_ORDER"
    ;;
  --kill)
    kill_session_for_pane "${2:-}"
    ;;
  --go)
    pane=${2:-}
    [[ -n $pane ]] || exit 1
    shift 2
    client=''
    [[ ${1:-} == --client ]] && client=${2:-}
    go_to_pane "$pane" "$client"
    ;;
  *)
    client=''
    [[ ${1:-} == --client ]] && client=${2:-}
    interactive "$client"
    ;;
esac
