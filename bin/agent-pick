#!/usr/bin/env bash
set -u

TMUX_BIN=${TMUX_BIN:-tmux}
ROOT=$(cd "$(dirname "$0")/.." && pwd)
NORMAL_FOOTER='Enter go  n new session  / filter  j/k move  Esc close'
FILTER_FOOTER='type to filter  Enter go  Esc back'
EMPTY_FOOTER='no agents — Enter go  n new session  / filter  j/k move  Esc close'

theme_option() {
  "$TMUX_BIN" show-options -gv "$1" 2>/dev/null || true
}

age_for() {
  local since=$1 now age
  now=$(date +%s)
  [[ $since =~ ^[0-9]+$ ]] || since=$now
  age=$((now - since))
  (( age < 0 )) && age=0
  if (( age < 60 )); then
    printf '%ss' "$age"
  elif (( age < 3600 )); then
    printf '%sm' $((age / 60))
  elif (( age < 86400 )); then
    printf '%sh' $((age / 3600))
  else
    printf '%sd' $((age / 86400))
  fi
}

session_has_visible_agent() {
  local session=$1 state command
  while IFS=$'\x1f' read -r state command; do
    case "$state:$command" in
      blocked:*|done:*|idle:*|working:*)
        case "$command" in
          zsh|bash|fish|sh) continue ;;
          *) return 0 ;;
        esac
        ;;
    esac
  done < <($TMUX_BIN list-panes -s -t "$session" -F $'#{@ap_state}\x1f#{pane_current_command}' 2>/dev/null || true)
  return 1
}

active_pane_for_session() {
  local session=$1 pane
  pane=$($TMUX_BIN display-message -p -t "$session" '#{pane_id}' 2>/dev/null || true)
  printf '%s' "$pane"
}

list_agents() {
  local pane state since agent session window pane_index command title tier age display
  local session_id session_name session_pane
  local format=$'#{pane_id}\x1f#{@ap_state}\x1f#{@ap_since}\x1f#{@ap_agent}\x1f#{session_name}\x1f#{window_index}\x1f#{pane_index}\x1f#{pane_current_command}\x1f#{pane_title}'
  {
    while IFS=$'\x1f' read -r pane state since agent session window pane_index command title; do
      [[ -n $pane && -n $state ]] || continue
      case "$command" in
        zsh|bash|fish|sh) continue ;;
      esac
      case "$state" in
        blocked) tier=0 ;;
        done) tier=1 ;;
        idle) tier=2 ;;
        working) tier=3 ;;
        *) continue ;;
      esac
      age=$(age_for "$since")
      display="$state $agent $session:$window.$pane_index $age $title"
      printf '%s\t%s\t%s\t%s\t%s\n' "$tier" "${since:-0}" "$pane" "$pane" "$display"
    done < <($TMUX_BIN list-panes -a -F "$format" 2>/dev/null || true)

    while IFS=$'\x1f' read -r session_id session_name; do
      [[ -n $session_id && -n $session_name ]] || continue
      session_has_visible_agent "$session_id" && continue
      session_pane=$(active_pane_for_session "$session_id")
      [[ -n $session_pane ]] || continue
      printf '4\t0\t%s\t%s\tsession %s\n' "$session_name" "$session_pane" "$session_name"
    done < <($TMUX_BIN list-sessions -F $'#{session_id}\x1f#{session_name}' 2>/dev/null || true)
  } |
    LC_ALL=C sort -t $'\t' -k1,1n -k2,2nr -k3,3 -k4,4 |
    awk -F '\t' 'BEGIN { OFS="\t" } { print $4, $5 }'
}

has_agent_rows() {
  local pane display state
  while IFS=$'\t' read -r pane display; do
    state=${display%% *}
    case "$state" in
      blocked|done|idle|working) return 0 ;;
    esac
  done <<< "${1:-}"
  return 1
}

colour_agents() {
  local pane display state colour rest
  while IFS=$'\t' read -r pane display; do
    [[ -n $pane ]] || continue
    state=${display%% *}
    rest=${display#* }
    case "$state" in
      blocked) colour='\033[31m' ;;
      done) colour='\033[32m' ;;
      idle) colour='\033[2m' ;;
      working) colour='\033[33m' ;;
      *) colour='' ;;
    esac
    printf '%s\t%b%s\033[0m %s\n' "$pane" "$colour" "$state" "$rest"
  done
}

client_quote() {
  printf '%q' "${1:-}"
}

go_to_pane() {
  local pane=$1 client=${2:-}
  if [[ -n $client ]]; then
    $TMUX_BIN switch-client -c "$client" -t "$pane" >/dev/null 2>&1 || true
  fi
  $TMUX_BIN select-window -t "$pane" >/dev/null 2>&1 || true
  $TMUX_BIN select-pane -t "$pane" >/dev/null 2>&1 || true
}

interactive() {
  local client=${1:-} client_q agents footer theme fzf_colors=()
  client_q=$(client_quote "$client")
  agents=$(list_agents)
  footer=$NORMAL_FOOTER
  has_agent_rows "$agents" || footer=$EMPTY_FOOTER
  theme=$(theme_option @ap_fzf_colors)
  [[ -n $theme ]] && fzf_colors=(--color="$theme")

  exec fzf \
    --ansi --delimiter=$'\t' --with-nth=2.. --no-sort --reverse \
    "${fzf_colors[@]}" \
    --with-shell 'bash -c' --no-input --footer "$footer" \
    --border-label=' agents ' --preview 'tmux capture-pane -ep -t {1}' \
    --preview-window='right:50%' \
    --bind "n:become($ROOT/bin/agent-new --client $client_q)" \
    --bind "/:show-input+unbind(n,/,j,k)+change-footer($FILTER_FOOTER)" \
    --bind 'j:down,k:up' \
    --bind "esc:transform:if [[ \$FZF_INPUT_STATE = enabled ]]; then echo 'clear-query+hide-input+rebind(n,/,j,k)+change-footer($footer)'; else echo abort; fi" \
    --bind "enter:become($ROOT/bin/agent-pick --go {1} --client $client_q)" \
    < <(colour_agents <<< "$agents")
}

case "${1:-}" in
  --list)
    list_agents
    ;;
  --go)
    pane=${2:-}
    [[ -n $pane ]] || exit 1
    shift 2
    client=''
    [[ ${1:-} == --client ]] && client=${2:-}
    go_to_pane "$pane" "$client"
    ;;
  *)
    client=''
    [[ ${1:-} == --client ]] && client=${2:-}
    interactive "$client"
    ;;
esac
